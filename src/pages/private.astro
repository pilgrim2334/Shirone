---
import Card from "@components/atoms/display/Card.svelte";
import ProtectedPost from "@components/organisms/ProtectedPost.svelte";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { encryptProtectedContent } from "@utils/password-protection";
import MarkdownIt from "markdown-it";
import { privateSpaceConfig } from "@/config";

if (!privateSpaceConfig.enable) return Astro.redirect("/404/");
if (!privateSpaceConfig.password.trim()) {
	throw new Error(
		"[private-space] password is required when the feature is enabled",
	);
}

const sources = import.meta.glob<string>("../content/private/*.md", {
	query: "?raw",
	import: "default",
	eager: true,
});
const markdown = new MarkdownIt({
	html: false,
	linkify: true,
	typographer: true,
});

function escapeHtml(value: string): string {
	return value
		.replaceAll("&", "&amp;")
		.replaceAll("<", "&lt;")
		.replaceAll(">", "&gt;")
		.replaceAll('"', "&quot;")
		.replaceAll("'", "&#039;");
}

function parseSource(source: string, filePath: string) {
	const match = source.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
	if (!match)
		throw new Error(`[private-space] missing frontmatter: ${filePath}`);
	const data = Object.fromEntries(
		match[1]
			.split(/\r?\n/)
			.map((line) => line.match(/^([A-Za-z][\w-]*):\s*(.*)$/))
			.filter((entry): entry is RegExpMatchArray => Boolean(entry))
			.map((entry) => [entry[1], entry[2].replace(/^['"]|['"]$/g, "")]),
	);
	if (!data.title || !data.published) {
		throw new Error(
			`[private-space] title and published are required: ${filePath}`,
		);
	}
	return {
		title: data.title,
		published: data.published,
		description: data.description ?? "",
		body: match[2],
	};
}

const posts = Object.entries(sources)
	.map(([filePath, source]) => parseSource(source, filePath))
	.sort((a, b) => b.published.localeCompare(a.published));

const privateHtml = `
	<div class="private-space">
		<header class="private-space__header">
			<p>${posts.length} 篇私人文章</p>
		</header>
		${posts
			.map(
				(post, index) => `
					<article class="private-space__article" id="private-post-${index + 1}">
						<p class="private-space__date"><time datetime="${escapeHtml(post.published)}">${escapeHtml(post.published)}</time></p>
						<h2>${escapeHtml(post.title)}</h2>
						${post.description ? `<p class="private-space__description">${escapeHtml(post.description)}</p>` : ""}
						${markdown.render(post.body)}
					</article>`,
			)
			.join("")}
	</div>`;

const scope = "post:private-space";
const payload = await encryptProtectedContent(
	privateHtml,
	privateSpaceConfig.password,
	scope,
	"text/html",
);
---

<MainGridLayout
	title={privateSpaceConfig.title}
	description={privateSpaceConfig.description}
	page="post"
>
	<Card color="var(--card-bg)" radius="l" class="private-space-card px-6 md:px-9 py-8 w-full">
		<ProtectedPost
			{payload}
			{scope}
			hint={privateSpaceConfig.passwordHint}
			title={privateSpaceConfig.title}
			description={privateSpaceConfig.description}
			headingIcon="material-symbols:shield-lock-outline-rounded"
			client:only="svelte"
		/>
	</Card>
</MainGridLayout>

<style is:global lang="stylus">
.private-space-card
	min-height: 24rem

.private-space
	display: grid
	gap: var(--m3e-space-8)

	&__header p
		margin: 0
		color: var(--on-surface-variant)
		font: var(--m3e-type-label-large)

	&__article
		padding-block-start: var(--m3e-space-6)
		border-block-start: 1px solid var(--outline-variant)

	&__article:first-of-type
		padding-block-start: 0
		border-block-start: 0

	&__date
		margin-block-end: var(--m3e-space-2)
		color: var(--primary)
		font: var(--m3e-type-label-large)

	&__description
		color: var(--on-surface-variant)
</style>
